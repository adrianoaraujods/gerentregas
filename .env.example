# Database Connection
# Host port 5433 maps to the postgres container's 5432 (see docker-compose.yml).
DATABASE_URL=postgresql://gerentregas:gerentregas@localhost:5433/gerentregas
# Optional: unpooled URL used by Drizzle Kit migrations (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=postgresql://gerentregas:gerentregas@localhost:5433/gerentregas

# Better Auth
BETTER_AUTH_SECRET=<you-should-not-use-this-secret-in-prod>
BETTER_AUTH_URL=http://localhost:3000

# SMTP (used by the password-reset email)
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Admin Credentials
# Required on every app start (dev and production): `pnpm dev` and `pnpm start` run the admin seed before booting. The server refuses to start without them.
ADMIN_EMAIL=
ADMIN_PASSWORD=