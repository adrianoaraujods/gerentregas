    usecase "UC37\nRestaurar roteiro" as UC37
    usecase "UC38\nConsultar histórico\nde versões" as UC38
    usecase "UC39\nCorrigir horários\nda parada" as UC39
  }
  package "Execução do roteiro" {
    usecase "UC40\nConsultar roteiro do dia" as UC40
    usecase "UC41\nIniciar turno" as UC41
    usecase "UC42\nEscolher veículo" as UC42
