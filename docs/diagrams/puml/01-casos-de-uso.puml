    usecase "UC29\nConsultar roteiro" as UC29
    usecase "UC30\nEditar roteiro" as UC30
    usecase "UC31\nGerar versão\ndo roteiro" as UC31
    usecase "UC32\nAdicionar parada" as UC32
    usecase "UC33\nEditar parada" as UC33
    usecase "UC34\nConcluir parada" as UC34
    usecase "UC35\nExcluir parada" as UC35
