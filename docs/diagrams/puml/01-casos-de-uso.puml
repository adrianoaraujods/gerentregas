    usecase "UC48\nReprocessar registro\nrejeitado" as UC48
    usecase "UC49\nDescartar registro\nrejeitado" as UC49
  }
  package "Dashboard e relatórios" {
    usecase "UC50\nConsultar dashboard\ndiário" as UC50
    usecase "UC51\nConsultar dashboard\nmensal" as UC51
    usecase "UC52\nConsultar dashboard\npor período" as UC52
    usecase "UC53\nConsultar detalhes\nde um dia" as UC53
    usecase "UC54\nExportar relatório CSV" as UC54
    usecase "UC55\nConsultar jornada padrão" as UC55
    usecase "UC56\nConsultar parâmetros" as UC56
    usecase "UC57\nAtualizar parâmetros" as UC57
  }
}

