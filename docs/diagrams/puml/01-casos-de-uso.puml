' Gerentregas — Diagrama de Casos de Uso
' Fonte: docs/diagramas.md | UCs derivados das procedures tRPC (auth, drivers,
' fleet, points, routes, dashboard, parameters, sync) e das telas correspondentes.
' A especializacao Administrador -> Gerente reflete roleMiddleware(["manager", "admin"]).
@startuml 01-casos-de-uso
title Gerentregas — Diagrama de Casos de Uso
left to right direction

skinparam actor {
  BackgroundColor white
  BorderColor #3b5bdb
}
skinparam usecase {
  BackgroundColor white
  BorderColor #495057
}
skinparam package {
  BackgroundColor #F1F3F5
  BorderColor #adb5bd
}

actor "Usuário\nnão autenticado" as NaoAutenticado
actor "Motorista /\nMotoboy" as Motorista
actor "Gerente /\nCoordenador" as Gerente
actor "Administrador" as Administrador

Administr --|> Gerente : especializa

rectangle "Sistema de Gestão de Rotas e Entregas" {
  package "Conta e acesso" {
    usecase "UC01\nCadastrar-se" as UC01
    usecase "UC02\nAutenticar-se" as UC02
    usecase "UC03\nEncerrar sessão" as UC03
    usecase "UC04\nSolicitar redefinição\nde senha" as UC04
    usecase "UC05\nRedefinir senha\ncom token" as UC05
    usecase "UC06\nConsultar próprio perfil" as UC06
    usecase "UC07\nAlterar tema da conta" as UC07
  }
  package "Gestão de usuários" {
    usecase "UC08\nCadastrar motorista" as UC08
    usecase "UC09\nCadastrar gerente" as UC09
    usecase "UC10\nListar usuários" as UC10
    usecase "UC11\nConsultar usuário" as UC11
    usecase "UC12\nAtualizar dados\ndo usuário" as UC12
    usecase "UC13\nExcluir usuário" as UC13
    usecase "UC14\nRestaurar usuário" as UC14
  }
  package "Gestão de veículos" {
    usecase "UC15\nCadastrar veículo" as UC15
    usecase "UC16\nListar veículos" as UC16
    usecase "UC17\nEditar veículo" as UC17
    usecase "UC18\nExcluir veículo" as UC18
  }
  package "Gestão de pontos" {
    usecase "UC19\nCadastrar ponto" as UC19
    usecase "UC20\nConsultar ponto" as UC20
    usecase "UC21\nListar pontos" as UC21
    usecase "UC22\nEditar ponto" as UC22
